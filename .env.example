# Environment Configuration Template
# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file or real secrets to version control.

APP_ENV=development
DATA_DIR=data
OUTPUT_DIR=outputs
MODEL_PATH=artifacts/models/pm25_forecaster.joblib
PREDICTIONS_PATH=artifacts/predictions/test_predictions.csv
METRICS_PATH=artifacts/reports/metrics_summary.json
QUALITY_ASSESSMENT_PATH=reports/data_quality/agent_quality_assessment.json
QUALITY_LOG_PATH=reports/data_quality/quality_log.csv

# Prefect Orchestration Settings
PREFECT_API_URL=
PREFECT_WORK_POOL_NAME=pm25-work-pool
PREFECT_FLOW_NAME=pm25-hourly-orchestration
TIMEZONE=Asia/Karachi
SCHEDULE_CRON=0 * * * *

# Optional LLM / API Credentials (for grounded agent augmentation)
GEMINI_API_KEY=
OPENAQ_API_KEY=
