# Web Application Environment Configuration Template
# Copy this file to .env or .env.local to customize local development settings.
# By default, the app loads verified static telemetry directly from /data/*.json

# Optional: Port configuration
PORT=3000

# Optional: Remote backend API URL (e.g. for production FastAPI serving or remote inference)
# VITE_API_BASE_URL=http://localhost:8000

# Optional: Gemini API key for live LLM chat generation (defaults to grounded rule-based RAG if omitted)
# GEMINI_API_KEY=
